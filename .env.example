# Email Workflow Platform — Environment Variables
# Copy to .env and fill in your values.

# --- LLM Provider API Keys ---
# Only one is required depending on your configured provider.

DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Email Account ---
# Gmail account used by the gog CLI for sending/searching
EMAIL_ACCOUNT=you@gmail.com

# --- Web App ---
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8000
WEBAPP_RELOAD=true

# --- Logging ---
LOG_LEVEL=INFO
