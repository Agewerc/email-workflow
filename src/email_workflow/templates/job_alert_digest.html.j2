<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#edf2f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#13202b;">
  <div style="max-width:720px;margin:0 auto;padding:24px 16px 40px;">
    <div style="background:linear-gradient(135deg,#0b3954,#087e8b);padding:28px;border-radius:20px;color:#f5fbff;box-shadow:0 14px 30px rgba(11,57,84,0.18);margin-bottom:20px;">
      <div style="font-size:12px;letter-spacing:0.14em;text-transform:uppercase;opacity:0.8;">Email Workflow Platform</div>
      <h1 style="margin:12px 0 6px;font-size:30px;line-height:1.1;">{{ heading }}</h1>
      <p style="margin:0;font-size:15px;opacity:0.88;">{{ date_label }}</p>
    </div>
    {% for section in sections %}
    <section style="background:#ffffff;border:1px solid #d8e2ea;border-radius:16px;padding:18px 20px;margin-bottom:16px;box-shadow:0 6px 16px rgba(19,32,43,0.06);">
      <h2 style="margin:0 0 12px;font-size:16px;text-transform:uppercase;letter-spacing:0.08em;color:#087e8b;">{{ section_icons.get(section.name, '✦') }} {{ section.name }}</h2>
      {% if section.summary == "NO_STRONG_ITEMS" %}
      <p style="margin:0;color:#6a7b88;font-style:italic;">No strong items made the cut.</p>
      {% else %}
      {{ section.summary | summary_html }}
      {% endif %}
    </section>
    {% endfor %}
    <p style="margin:22px 0 0;text-align:center;font-size:12px;color:#758592;">{{ footer_label }} · {{ date_label }}</p>
  </div>
</body>
</html>
